print("  🚀 INTERCEPTING EXCLUSIVITY ONLY... ")
print("====================================")

local assets = game:GetService("ReplicatedStorage"):WaitForChild("Assets")
local unlockCount = 0

-- Helper function to safely isolate and patch only the Exclusive field
local function patchConfig(configModule, debugName)
    if configModule and configModule:IsA("ModuleScript") then
        local success, liveData = pcall(function()
            return require(configModule)
        end)
        
        if success and type(liveData) == "table" then
            -- ONLY changing this value
            liveData.Exclusive = false
            unlockCount = unlockCount + 1
            print("Set Exclusive = false for: " .. tostring(debugName))
        end
    end
end
-- ================================================
-- STEP 3: PATCH SURVIVOR: HELPERBOT
-- ================================================
local helperbotConfig = assets:FindFirstChild("Survivors")
    and assets.Survivors:FindFirstChild("Helperbot")
    and assets.Survivors.Helperbot:FindFirstChild("Config")

if helperbotConfig then
    patchConfig(helperbotConfig, "Survivor: Helperbot")
end


-- ================================================
-- STEP 1: PATCH ALL MAIN KILLER CHARACTERS
-- ================================================
local killersFolder = assets:FindFirstChild("Killers")
if killersFolder then
    for _, killer in pairs(killersFolder:GetChildren()) do
        if killer:IsA("Folder") then
            local config = killer:FindFirstChild("Config")
            patchConfig(config, "Killer: " .. killer.Name)
        elseif killer:IsA("ModuleScript") then
            patchConfig(killer, "Standalone Killer: " .. killer.Name)
        end
    end
end

local killersFolder = assets:FindFirstChild("Survivors")
