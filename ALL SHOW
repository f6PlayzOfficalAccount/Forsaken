local assets = game:GetService("ReplicatedStorage"):WaitForChild("Assets")
local unlockCount = 0

-- Helper function to safely isolate and patch only the Exclusive field
local function patchConfig(configModule, debugName)
    if configModule and configModule:IsA("ModuleScript") then
        local success, liveData = pcall(function()
            return require(configModule)
        end)
        
        if success and type(liveData) == "table" then
            -- ONLY changing this value
            liveData.Exclusive = false
            unlockCount = unlockCount + 1
            print("Set Exclusive = false for: " .. tostring(debugName))
        end
    end
end
