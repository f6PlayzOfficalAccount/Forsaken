-- STEP 1: PATCH ALL MAIN KILLER CHARACTERS
-- ================================================
local killersFolder = assets:FindFirstChild("Killers")
if killersFolder then
    for _, killer in pairs(killersFolder:GetChildren()) do
        if killer:IsA("Folder") then
            local config = killer:FindFirstChild("Config")
            patchConfig(config, "Killer: " .. killer.Name)
        elseif killer:IsA("ModuleScript") then
            patchConfig(killer, "Standalone Killer: " .. killer.Name)
        end
